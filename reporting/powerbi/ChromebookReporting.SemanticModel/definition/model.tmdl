model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["SqlServer","SqlDatabase","LoginHistoryDays","Devices","Users","Logins","Calendar","SyncState","IngestionErrors"]

ref table Devices
ref table Users
ref table Logins
ref table Calendar
ref table SyncState
ref table IngestionErrors

