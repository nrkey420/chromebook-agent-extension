/// One row per ChromeOS device: Google inventory plus the extension's last check-in.
table Devices
	lineageTag: 456d930a-e1db-c7e1-daf1-79ea413768f3

	/// Devices in the inventory (Google inventory plus devices only the extension has seen).
	measure Devices = COUNTROWS ( Devices )
		formatString: #,0
		displayFolder: Fleet
		lineageTag: e2b245c4-7e25-f84e-404a-15648b85c2ac

	/// Devices the extension heard from in the last 24 hours.
	measure 'Reporting (24h)' = CALCULATE ( COUNTROWS ( Devices ), Devices[ExtLastSeenUtc] >= UTCNOW () - 1 )
		formatString: #,0
		displayFolder: Fleet
		lineageTag: ef7dae84-83f3-9fd4-8167-60246f09e356

	measure 'Reporting (7d)' = CALCULATE ( COUNTROWS ( Devices ), Devices[ExtLastSeenUtc] >= UTCNOW () - 7 )
		formatString: #,0
		displayFolder: Fleet
		lineageTag: 416bc9b1-0f2c-6b45-7a34-917d52409465

	measure 'Never reported' = CALCULATE ( COUNTROWS ( Devices ), Devices[ExtensionReportingStatus] = "NEVER_REPORTED" )
		formatString: #,0
		displayFolder: Fleet
		lineageTag: 8f4e0919-1e62-af83-55cd-ce98e5b98120

	/// Google saw the device more than a day after the extension last reported.
	measure 'Extension silent' = CALCULATE ( COUNTROWS ( Devices ), Devices[ExtensionReportingStatus] = "EXTENSION_SILENT" )
		formatString: #,0
		displayFolder: Fleet
		lineageTag: 2468600f-817c-f159-3af5-3020c73e2720

	/// Devices that checked in with Google in the last 24 hours.
	measure 'Google active (24h)' = CALCULATE ( COUNTROWS ( Devices ), Devices[GoogleLastSyncUtc] >= UTCNOW () - 1 )
		formatString: #,0
		displayFolder: Fleet
		lineageTag: e982d34f-d3be-8e79-1b6c-4a7b78f2b366

	/// Of the devices Google saw in the last 24 hours, the share the extension also reported from.
	measure 'Coverage %' =
			DIVIDE (
			    CALCULATE (
			        COUNTROWS ( Devices ),
			        Devices[GoogleLastSyncUtc] >= UTCNOW () - 1,
			        Devices[ExtLastSeenUtc] >= UTCNOW () - 1
			    ),
			    [Google active (24h)]
			)
		formatString: 0.0%
		displayFolder: Fleet
		lineageTag: 47785ce1-55d3-7444-acb2-312e4e89e6f0

