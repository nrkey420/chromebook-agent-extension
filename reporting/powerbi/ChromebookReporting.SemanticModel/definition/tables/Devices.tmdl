				    Selected = Table.SelectColumns(View, {"DirectoryDeviceId", "SerialNumber", "AssetId", "AnnotatedLocation", "AnnotatedUser", "DeviceOrgUnit", "Model", "OsVersion", "AutoUpdateThrough", "GoogleStatus", "MacAddress", "LastUserEmail", "LastUserStudentId", "GoogleLastSyncUtc", "GoogleLastSyncLocal", "ExtLastSeenUtc", "ExtLastSeenLocal", "ExtLastInternalIp", "ExtLastPublicIp", "ExtVersion", "ExtensionReportingStatus"})
				in
				    Selected

