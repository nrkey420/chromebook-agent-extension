/// Every login/logout from the extension and Google (ChromeOS and account sign-ins), with the IPs in use.
table Logins
	lineageTag: ac06fa2c-5df1-4c01-bfa7-e255c4c69b5a

	/// Device sign-ins reported by Google.
	measure 'ChromeOS logins' = CALCULATE ( COUNTROWS ( Logins ), Logins[Source] = "GOOGLE_CHROMEOS", Logins[LoginEvent] = "LOGIN" )
		formatString: #,0
		displayFolder: Logins
		lineageTag: da9ea2e4-ce62-8ee2-de31-58d72b6b587c

	/// Sessions started, as reported by the extension.
	measure 'Extension sessions' = CALCULATE ( COUNTROWS ( Logins ), Logins[Source] = "EXTENSION", Logins[LoginEvent] = "SESSION_START" )
		formatString: #,0
		displayFolder: Logins
		lineageTag: ae1b1a43-4b74-a4a9-fc99-3e5836127517

	/// Failed ChromeOS logins and failed Google account sign-ins.
	measure 'Login failures' = CALCULATE ( COUNTROWS ( Logins ), Logins[LoginEvent] = "LOGIN_FAILURE" )
		formatString: #,0
		displayFolder: Logins
		lineageTag: f2166f14-892b-64fd-2736-47f0ba817da1

	/// Distinct users who signed in to a device (Google ChromeOS login or extension session).
	measure 'Users signed in' = CALCULATE ( DISTINCTCOUNT ( Logins[UserEmail] ), Logins[LoginEvent] IN { "LOGIN", "SESSION_START" }, Logins[Source] <> "GOOGLE_ACCOUNT" )
		formatString: #,0
		displayFolder: Logins
		lineageTag: 084462d4-65b5-3152-e68b-520939fdd5d0

	/// Distinct devices someone signed in to.
	measure 'Devices used' = CALCULATE ( DISTINCTCOUNT ( Logins[DirectoryDeviceId] ), Logins[LoginEvent] IN { "LOGIN", "SESSION_START" }, Logins[Source] <> "GOOGLE_ACCOUNT" )
		formatString: #,0
		displayFolder: Logins
		lineageTag: 6e519756-26ca-c393-d362-e955382a2053

	measure 'Last sign-in' = CALCULATE ( MAX ( Logins[EventTimeLocal] ), Logins[LoginEvent] IN { "LOGIN", "SESSION_START" }, Logins[Source] <> "GOOGLE_ACCOUNT" )
		formatString: yyyy-mm-dd hh:nn
		displayFolder: Logins
		lineageTag: 84b4b513-fdea-ae87-9efe-8aee7a9e4ea2

	measure 'First sign-in' = CALCULATE ( MIN ( Logins[EventTimeLocal] ), Logins[LoginEvent] IN { "LOGIN", "SESSION_START" }, Logins[Source] <> "GOOGLE_ACCOUNT" )
		formatString: yyyy-mm-dd hh:nn
		displayFolder: Logins
		lineageTag: 3aad7a63-19e4-0827-ba9f-44d959a4e672

	/// Which sources saw these sign-ins. "Google only" usually means the extension is not installed for that user's OU, so there is no web activity for them.
	measure 'Extension coverage' =
			VAR google = [ChromeOS logins]
			VAR extension = [Extension sessions]
			RETURN
			    SWITCH (
			        TRUE (),
			        google > 0 && extension > 0, "Google and extension",
			        google > 0, "Google only - extension not reporting",
			        extension > 0, "Extension only",
			        BLANK ()
			    )
		displayFolder: Logins
		lineageTag: 3fce4483-97cc-b4cc-d9d0-b845b3c91ab9

	column EventTimeUtc
		dataType: dateTime
		isHidden
		formatString: yyyy-mm-dd hh:nn
		lineageTag: 1e72a9c8-0e59-ea2e-f26b-cef9cb861a9d
		summarizeBy: none
		sourceColumn: EventTimeUtc

	column EventTimeLocal
