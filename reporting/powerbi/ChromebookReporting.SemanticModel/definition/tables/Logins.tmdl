	/// Local date of the event.
	column EventDate
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: a41863c3-9f26-8f99-8ee7-8d9a4092a87d
		summarizeBy: none
		sourceColumn: EventDate

	/// Local hour of the event (0-23).
	column EventHour
		dataType: int64
		formatString: 0
		lineageTag: b3037617-64d0-28fa-5a68-5b6c55b43582
		summarizeBy: none
		sourceColumn: EventHour

	column Weekday
		dataType: string
		lineageTag: 8f479349-2fcf-1e0d-3b41-5f007a85bf84
		summarizeBy: none
		sourceColumn: Weekday
		sortByColumn: WeekdayNumber

	column WeekdayNumber
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: e010b1bc-84e5-268c-088d-31fc9560aae6
		summarizeBy: none
		sourceColumn: WeekdayNumber

	partition Logins = m
		mode: import
		source =
				let
				    Source = Sql.Database(SqlServer, SqlDatabase),
				    View = Source{[Schema = "dbo", Item = "vw_LoginHistory"]}[Data],
				    Selected = Table.SelectColumns(View, {"EventTimeUtc", "EventTimeLocal", "Source", "LoginEvent", "UserEmail", "StudentId", "UserOrgUnit", "DirectoryDeviceId", "SerialNumber", "AssetId", "AnnotatedLocation", "DeviceOrgUnit", "InternalIp", "PublicIp", "Detail", "SessionId"}),
				    // Filter in SQL (query folding): only the last LoginHistoryDays days.
				    Since = DateTimeZone.RemoveZone(DateTimeZone.UtcNow()) - #duration(LoginHistoryDays, 0, 0, 0),
				    Recent = Table.SelectRows(Selected, each [EventTimeUtc] >= Since),
				    Guids = Table.TransformColumnTypes(Recent, {{"SessionId", type text}}),
				    WithDate = Table.AddColumn(Guids, "EventDate", each Date.From([EventTimeLocal]), type date),
				    WithHour = Table.AddColumn(WithDate, "EventHour", each Time.Hour([EventTimeLocal]), Int64.Type),
				    WithWeekday = Table.AddColumn(WithHour, "Weekday", each Date.DayOfWeekName([EventTimeLocal], "en-US"), type text),
				    WithWeekdayNumber = Table.AddColumn(WithWeekday, "WeekdayNumber", each Date.DayOfWeek([EventTimeLocal], Day.Monday) + 1, Int64.Type)
				in
				    WithWeekdayNumber

