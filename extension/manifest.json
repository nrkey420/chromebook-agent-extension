{
  "manifest_version": 3,
  "name": "Chromebook Session Attribution PoC",
  "version": "0.3.0",
  "description": "Managed Chromebook session attribution and browser telemetry PoC.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "alarms",
    "downloads",
    "enterprise.deviceAttributes",
    "enterprise.networkingAttributes",
    "history",
    "identity",
    "identity.email",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://*.azurewebsites.net/*"
  ],
  "storage": {
    "managed_schema": "policy/managed_schema.json"
  },
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "minimum_chrome_version": "116"
}
